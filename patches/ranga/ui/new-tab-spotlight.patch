+gfx::Rect RangaContentsArea(BrowserView* browser_view) {
+  views::View* contents = browser_view->multi_contents_view();
+  if (!contents || !contents->GetVisible()) {
+    return browser_view->GetLocalBounds();
+  }
+  return views::View::ConvertRectToTarget(contents, browser_view,
+                                          contents->GetLocalBounds());
+}
+
+bool RangaShowSpotlight(BrowserWindowInterface* browser,
+                        std::string_view mode) {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "ranga-native-chrome") ||
+      browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+    return false;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view) {
+    return false;
+  }
+  RangaOverlayFor(browser_view, "spotlight.html")
+      ->Show(mode, RangaContentsArea(browser_view));
+  return true;
+}
