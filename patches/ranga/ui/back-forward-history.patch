+ExtensionFunction::ResponseAction RangaPrivateGetHistoryFunction::Run() {
+  auto params = ranga_private::GetHistory::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  content::WebContents* contents = nullptr;
+  if (!ExtensionTabUtil::GetTabById(params->tab_id, browser_context(),
+                                    /*include_incognito=*/true, &contents) ||
+      !contents) {
+    return RespondNow(Error("No tab with that id."));
+  }
+  content::NavigationController& controller = contents->GetController();
+  const int current = controller.GetCurrentEntryIndex();
+  const int step = params->forward ? 1 : -1;
+  std::vector<ranga_private::HistoryEntry> entries;
+  for (int index = current + step;
+       index >= 0 && index < controller.GetEntryCount() &&
+       entries.size() < kMaxHistoryEntries;
+       index += step) {
+    content::NavigationEntry* entry = controller.GetEntryAtIndex(index);
+    if (entry->IsInitialEntry()) {
+      continue;
+    }
+    ranga_private::HistoryEntry& item = entries.emplace_back();
+    item.offset = index - current;
+    item.title = base::UTF16ToUTF8(entry->GetTitleForDisplay());
+    item.url = entry->GetVirtualURL().spec();
+  }
+  return RespondNow(
+      ArgumentList(ranga_private::GetHistory::Results::Create(entries)));
+}
+
+ExtensionFunction::ResponseAction RangaPrivateGoToHistoryFunction::Run() {
+  auto params = ranga_private::GoToHistory::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  content::WebContents* contents = nullptr;
+  if (!ExtensionTabUtil::GetTabById(params->tab_id, browser_context(),
+                                    /*include_incognito=*/true, &contents) ||
+      !contents) {
+    return RespondNow(Error("No tab with that id."));
+  }
+  content::NavigationController& controller = contents->GetController();
+  if (!controller.CanGoToOffset(params->offset)) {
+    return RespondNow(Error("The tab can't go that far."));
+  }
+  controller.GoToOffset(params->offset);
+  return RespondNow(NoArguments());
+}
