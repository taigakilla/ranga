+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_RANGA_LOAD_SNAKE_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_RANGA_LOAD_SNAKE_H_
+
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+class PrefService;
+
+// A glowing snake that runs around the page card while the active tab loads,
+// grows with the load progress and closes the loop when it finishes.
+class RangaLoadSnake : public views::View, public content::WebContentsObserver {
+  METADATA_HEADER(RangaLoadSnake, views::View)
+
+ public:
+  static constexpr int kOutset = 6;
+
+  explicit RangaLoadSnake(PrefService* prefs);
+  RangaLoadSnake(const RangaLoadSnake&) = delete;
+  RangaLoadSnake& operator=(const RangaLoadSnake&) = delete;
+  ~RangaLoadSnake() override;
+
+  void SetWebContents(content::WebContents* contents);
+  void SetCard(const gfx::Rect& card, float radius);
+
+ private:
+  void Begin(double progress);
+  void Finish();
+  void Reset();
+  void Tick();
+  bool Enabled() const;
+  void Sync();
+
+  // content::WebContentsObserver:
+  void DidStartNavigation(content::NavigationHandle* navigation) override;
+  void LoadProgressChanged(double progress) override;
+  void DidStopLoading() override;
+  void WebContentsDestroyed() override;
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+
+  PrefChangeRegistrar prefs_;
+  base::RepeatingTimer timer_;
+  base::TimeTicks started_;
+  base::TimeTicks finished_;
+  double target_ = 0;
+  double shown_ = 0;
+  bool loading_ = false;
+  bool finishing_ = false;
+  float radius_ = 0;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_RANGA_LOAD_SNAKE_H_
