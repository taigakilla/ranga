+void ComponentLoader::AddRangaSidebarExtension() {
+  base::FilePath dir =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+          kRangaSidebarDirSwitch);
+  if (dir.empty()) {
+    if (!base::PathService::Get(chrome::DIR_RESOURCES, &dir)) {
+      return;
+    }
+    dir = dir.AppendASCII(kRangaSidebarResourcesDir);
+  }
+  if (!dir.IsAbsolute()) {
+    LOG(ERROR) << "--" << kRangaSidebarDirSwitch
+               << " must be an absolute path: " << dir;
+    return;
+  }
+  std::string error;
+  std::optional<base::DictValue> manifest =
+      file_util::LoadManifest(dir, &error);
+  if (!manifest) {
+    LOG(ERROR) << "Ranga's sidebar couldn't load from " << dir << ": "
+               << error;
+  }
+  FinishAddRangaSidebar(dir, std::move(manifest));
+}
+
+void ComponentLoader::FinishAddRangaSidebar(
+    const base::FilePath& dir,
+    std::optional<base::DictValue> manifest) {
+  if (!manifest) {
+    return;
+  }
+  const ExtensionId id =
+      Add(std::move(*manifest), dir, /*skip_allowlist=*/false);
+  if (id != kRangaSidebarExtensionId) {
+    LOG(ERROR) << "Ranga's sidebar at " << dir << " has the id " << id
+               << "; its manifest key must give " << kRangaSidebarExtensionId;
+  }
+}
