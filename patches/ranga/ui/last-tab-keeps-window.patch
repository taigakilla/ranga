   }
 
+  if (browser->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+      !browser->GetProfile()->IsOffTheRecord() &&
+      browser->GetTabStripModel()->count() == 1) {
+    content::WebContents* last = active_tab->GetContents();
+    if (last->GetVisibleURL() == GURL(chrome::kChromeUINewTabURL)) {
+      return;
+    }
+    NewTab(browser, NewTabTypes::kNewTabCommand);
+    last->Close();
+    return;
+  }
