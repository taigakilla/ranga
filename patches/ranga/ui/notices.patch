+ExtensionFunction::ResponseAction RangaPrivateShowNoticeFunction::Run() {
+  auto params = ranga_private::ShowNotice::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  RangaShowNotice(browser, params->icon, base::UTF8ToUTF16(params->text),
+                  base::UTF8ToUTF16(params->action), params->id,
+                  base::OnceClosure());
+  return RespondNow(NoArguments());
+}
