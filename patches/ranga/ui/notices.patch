+gfx::Rect RangaNoticeCard(BrowserView* browser_view) {
+  constexpr int kWidth = 472;
+  constexpr int kHeight = 112;
+  const gfx::Rect area = RangaContentsArea(browser_view);
+  const int width = std::min(kWidth, area.width());
