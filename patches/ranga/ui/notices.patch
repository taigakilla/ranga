+bool RangaShowNotice(BrowserWindowInterface* browser,
+                     std::string_view icon,
+                     std::u16string_view text,
+                     std::u16string_view action,
+                     std::string_view id,
+                     base::OnceClosure run) {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "ranga-native-chrome")) {
+    return false;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view) {
+    return false;
+  }
+  RangaSpotlightView* overlay = RangaOverlayFor(browser_view, "notice.html");
+  overlay->SetAction(std::move(run));
+  overlay->Show(
+      "icon=" + base::EscapeAllExceptUnreserved(icon) +
+          "&text=" + base::EscapeAllExceptUnreserved(base::UTF16ToUTF8(text)) +
+          "&action=" +
+          base::EscapeAllExceptUnreserved(base::UTF16ToUTF8(action)) +
+          "&id=" + base::EscapeAllExceptUnreserved(id) + "&n=",
+      RangaNoticeCard(browser_view), /*focus=*/false);
+  return true;
+}
