+ExtensionFunction::ResponseAction RangaPrivateShowPageInfoFunction::Run() {
+  auto params = ranga_private::ShowPageInfo::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  if (!ShowPageInfo(browser)) {
+    return RespondNow(Error(kNoPageInfoError));
+  }
+  return RespondNow(NoArguments());
