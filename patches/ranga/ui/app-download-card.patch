+gfx::Rect RangaDownloadCard(BrowserView* browser_view) {
+  constexpr int kWidth = 404;
+  constexpr int kHeight = 136;
+  const gfx::Rect area = RangaContentsArea(browser_view);
+  return gfx::Rect(area.right() - kWidth, area.bottom() - kHeight, kWidth,
+                   kHeight);
+}
+
