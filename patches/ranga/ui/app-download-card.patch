                                content::WebContents* contents) {
   if (auto* web = views::AsViewClass<views::WebView>(root);
@@ -329,7 +337,22 @@
 
 }  // namespace
 
+void RangaShowDownload(BrowserWindowInterface* browser, uint32_t id) {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view) {
+    return;
+  }
+  RangaOverlayFor(browser_view, "download.html")
+      ->Show(base::NumberToString(id), RangaDownloadCard(browser_view),
+             /*focus=*/false);
+}
+
 void RangaLayoutPanes(BrowserView* browser_view) {
+  if (RangaSpotlightView* download =
+          RangaFindOverlay(browser_view, "download.html");
+      download && download->GetVisible()) {
+    download->SetBoundsRect(RangaDownloadCard(browser_view));
+  }
   if (!RangaOwnsWindow(browser_view)) {
     return;
   }
