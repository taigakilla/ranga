@@ -0,0 +1,59 @@
+#include "chrome/browser/ui/views/frame/ranga_spotlight_view.h"
+
+#include <string>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/gfx/geometry/rect.h"
+#include "url/gurl.h"
+
+RangaSpotlightView::RangaSpotlightView(content::BrowserContext* browser_context,
+                                       base::RepeatingClosure on_hidden)
+    : views::WebView(browser_context), on_hidden_(std::move(on_hidden)) {
+  SetVisible(false);
+}
+
+RangaSpotlightView::~RangaSpotlightView() = default;
+
+void RangaSpotlightView::Show(bool new_tab, const gfx::Rect& bounds) {
+  SetBoundsRect(bounds);
+  content::WebContents* contents = GetWebContents();
+  contents->SetPageBaseBackgroundColor(SK_ColorTRANSPARENT);
+  const GURL url(
+      std::string("chrome-extension://hncljkmljckjojdjincglklbdihcaeko/"
+                  "spotlight.html#") +
+      (new_tab ? "new-" : "current-") + base::NumberToString(++generation_));
+  content::NavigationController::LoadURLParams params(url);
+  params.transition_type = ui::PAGE_TRANSITION_AUTO_TOPLEVEL;
+  params.should_replace_current_entry =
+      contents->GetController().GetEntryCount() > 0;
+  contents->GetController().LoadURLWithParams(params);
+  SetVisible(true);
+  RequestFocus();
+}
+
+void RangaSpotlightView::Hide() {
+  if (!GetVisible()) {
+    return;
+  }
+  SetVisible(false);
+  on_hidden_.Run();
+}
+
+void RangaSpotlightView::CloseContents(content::WebContents* source) {
+  Hide();
+}
+
+void RangaSpotlightView::TitleWasSet(content::NavigationEntry* entry) {
+  if (base::StartsWith(GetWebContents()->GetTitle(), u"ranga-spotlight:close")) {
+    Hide();
+  }
+}
+
+BEGIN_METADATA(RangaSpotlightView)
+END_METADATA
