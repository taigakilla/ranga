+void ShowRangaSpotlight(BrowserView* browser_view, bool new_tab) {
+  RangaSpotlightView* spotlight = nullptr;
+  for (views::View* child : browser_view->children()) {
+    if (auto* found = views::AsViewClass<RangaSpotlightView>(child)) {
+      spotlight = found;
+    }
+  }
+  if (!spotlight) {
+    spotlight = browser_view->AddChildView(std::make_unique<RangaSpotlightView>(
+        browser_view->browser()->GetProfile(),
+        base::BindRepeating(
+            [](BrowserView* view) {
+              if (views::WebView* contents = view->GetActiveContentsWebView()) {
+                contents->RequestFocus();
+              }
+            },
+            base::Unretained(browser_view))));
+  }
+  browser_view->ReorderChildView(spotlight, browser_view->children().size());
+  spotlight->Show(new_tab, browser_view->GetLocalBounds());
+}
