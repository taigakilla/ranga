+class RangaShortcutTarget : public ui::AcceleratorTarget {
+ public:
+  explicit RangaShortcutTarget(BrowserView* browser_view)
+      : browser_view_(browser_view) {}
+
+  ~RangaShortcutTarget() override { Unregister(); }
+
+  void Register() {
+    Unregister();
+    focus_manager_ = browser_view_->GetFocusManager();
+    if (!focus_manager_) {
+      return;
+    }
+    for (const auto& [accelerator, command] : Shortcuts()) {
+      focus_manager_->RegisterAccelerator(
+          accelerator, ui::AcceleratorManager::kHighPriority, this);
+    }
+  }
+
+  void Unregister() {
+    if (focus_manager_) {
+      focus_manager_->UnregisterAccelerators(this);
+      focus_manager_ = nullptr;
+    }
+  }
+
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override {
+    const auto it = Shortcuts().find(
+        ui::Accelerator(accelerator.key_code(), accelerator.modifiers()));
+    if (it == Shortcuts().end()) {
+      return false;
+    }
+    BrowserWindowInterface* browser = browser_view_->browser();
+    Profile* profile = browser->GetProfile()->GetOriginalProfile();
+    base::ListValue args;
+    args.Append(it->second);
+    args.Append(browser->GetSessionID().id());
+    auto event = std::make_unique<extensions::Event>(
+        extensions::events::COMMANDS_ON_COMMAND, "rangaPrivate.onShortcut",
+        std::move(args), profile);
+    event->user_gesture = extensions::EventRouter::UserGestureState::kEnabled;
+    extensions::EventRouter::Get(profile)->DispatchEventToExtension(
+        kRangaSidebarExtensionId, std::move(event));
+    return true;
+  }
+
+  bool CanHandleAccelerators() const override {
+    return browser_view_->IsActive();
+  }
+
+ private:
+  raw_ptr<BrowserView> browser_view_;
+  raw_ptr<views::FocusManager> focus_manager_ = nullptr;
+};
+
+}  // namespace
+
+DEFINE_UI_CLASS_PROPERTY_TYPE(RangaShortcutTarget*)
+DEFINE_OWNED_UI_CLASS_PROPERTY_KEY(RangaShortcutTarget,
+                                   kRangaShortcutTargetKey)
+
+std::optional<ui::Accelerator> ParseRangaAccelerator(std::string_view text) {
+  const std::vector<std::string_view> parts = base::SplitStringPiece(
+      text, "+", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+  if (parts.empty() || parts.back().empty()) {
+    return std::nullopt;
+  }
+  int modifiers = ui::EF_NONE;
+  for (size_t i = 0; i + 1 < parts.size(); ++i) {
+    const std::optional<int> modifier = ModifierFor(parts[i]);
+    if (!modifier) {
+      return std::nullopt;
+    }
+    modifiers |= *modifier;
+  }
+  const std::optional<ui::KeyboardCode> key = KeyFor(parts.back());
+  if (!key) {
+    return std::nullopt;
+  }
+  return ui::Accelerator(*key, modifiers);
+}
+
+void RangaSetShortcuts(std::map<ui::Accelerator, std::string> shortcuts) {
+  Shortcuts() = std::move(shortcuts);
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [](BrowserWindowInterface* browser) {
+        if (BrowserView* view = BrowserView::GetBrowserViewForBrowser(browser);
+            view && view->GetProperty(kRangaShortcutTargetKey)) {
+          view->GetProperty(kRangaShortcutTargetKey)->Register();
+        }
+        return true;
+      });
+}
+
+bool RangaHasShortcut(const ui::Accelerator& accelerator) {
+  return Shortcuts().contains(
+      ui::Accelerator(accelerator.key_code(), accelerator.modifiers()));
+}
+
+void RangaRegisterShortcuts(BrowserView* browser_view) {
+  RangaShortcutTarget* target =
+      browser_view->GetProperty(kRangaShortcutTargetKey);
+  if (!target) {
+    target = browser_view->SetProperty(
+        kRangaShortcutTargetKey,
+        std::make_unique<RangaShortcutTarget>(browser_view));
+  }
+  target->Register();
+}
