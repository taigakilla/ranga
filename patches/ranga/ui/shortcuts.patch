+ExtensionFunction::ResponseAction RangaPrivateSetShortcutsFunction::Run() {
+  auto params = ranga_private::SetShortcuts::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::map<ui::Accelerator, std::string> shortcuts;
+  std::vector<std::string> rejected;
+  for (const auto [keys, command] : params->shortcuts.additional_properties) {
+    const std::optional<ui::Accelerator> accelerator =
+        ParseRangaAccelerator(keys);
+    if (!accelerator || !command.is_string()) {
+      rejected.push_back(keys);
+      continue;
+    }
+    shortcuts[*accelerator] = command.GetString();
+  }
+  RangaSetShortcuts(std::move(shortcuts));
+  return RespondNow(ArgumentList(
+      ranga_private::SetShortcuts::Results::Create(rejected)));
+}
