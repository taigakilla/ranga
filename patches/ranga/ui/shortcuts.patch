+std::map<ui::Accelerator, std::string>& Shortcuts() {
+  static base::NoDestructor<std::map<ui::Accelerator, std::string>> shortcuts;
+  return *shortcuts;
+}
+
+std::optional<ui::KeyboardCode> KeyFor(std::string_view name) {
+  if (name.size() == 1) {
+    const char c = base::ToUpperASCII(name[0]);
+    if (c >= 'A' && c <= 'Z') {
+      return static_cast<ui::KeyboardCode>(ui::VKEY_A + (c - 'A'));
+    }
+    if (c >= '0' && c <= '9') {
+      return static_cast<ui::KeyboardCode>(ui::VKEY_0 + (c - '0'));
+    }
+    switch (c) {
+      case '[':
+        return ui::VKEY_OEM_4;
+      case ']':
+        return ui::VKEY_OEM_6;
+      case '=':
+        return ui::VKEY_OEM_PLUS;
+      case '-':
+        return ui::VKEY_OEM_MINUS;
+      case ',':
+        return ui::VKEY_OEM_COMMA;
+      case '.':
+        return ui::VKEY_OEM_PERIOD;
+      case '/':
+        return ui::VKEY_OEM_2;
+      case ';':
+        return ui::VKEY_OEM_1;
+      case '\'':
+        return ui::VKEY_OEM_7;
+      case '`':
+        return ui::VKEY_OEM_3;
+      case '\\':
+        return ui::VKEY_OEM_5;
+    }
+    return std::nullopt;
+  }
+  const std::string key = base::ToLowerASCII(name);
+  static constexpr struct {
+    const char* name;
+    ui::KeyboardCode code;
+  } kNamed[] = {
+      {"plus", ui::VKEY_OEM_PLUS},   {"tab", ui::VKEY_TAB},
+      {"space", ui::VKEY_SPACE},     {"enter", ui::VKEY_RETURN},
+      {"escape", ui::VKEY_ESCAPE},   {"backspace", ui::VKEY_BACK},
+      {"delete", ui::VKEY_DELETE},   {"up", ui::VKEY_UP},
+      {"down", ui::VKEY_DOWN},       {"left", ui::VKEY_LEFT},
+      {"right", ui::VKEY_RIGHT},     {"home", ui::VKEY_HOME},
+      {"end", ui::VKEY_END},         {"pageup", ui::VKEY_PRIOR},
+      {"pagedown", ui::VKEY_NEXT},
+  };
+  for (const auto& named : kNamed) {
+    if (key == named.name) {
+      return named.code;
+    }
+  }
+  int f = 0;
+  if (key.size() >= 2 && key[0] == 'f' &&
+      base::StringToInt(std::string_view(key).substr(1), &f) && f >= 1 &&
+      f <= 24) {
+    return static_cast<ui::KeyboardCode>(ui::VKEY_F1 + (f - 1));
+  }
+  return std::nullopt;
+}
+
+std::optional<int> ModifierFor(std::string_view name) {
+  const std::string modifier = base::ToLowerASCII(name);
+  if (modifier == "ctrl") {
+    return ui::EF_CONTROL_DOWN;
+  }
+  if (modifier == "alt") {
+    return ui::EF_ALT_DOWN;
+  }
+  if (modifier == "shift") {
+    return ui::EF_SHIFT_DOWN;
+  }
+  if (modifier == "super") {
+    return ui::EF_COMMAND_DOWN;
+  }
+  return std::nullopt;
+}
