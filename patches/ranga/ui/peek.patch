+#ifndef CHROME_BROWSER_RANGA_RANGA_LINKS_H_
+#define CHROME_BROWSER_RANGA_RANGA_LINKS_H_
+
+#include <memory>
+
+#include "base/containers/flat_set.h"
+#include "base/functional/callback.h"
+
+class BrowserWindowInterface;
+
+namespace content {
+struct OpenURLParams;
+class WebContents;
+}  // namespace content
+
+// Tabs (extension tab ids) whose links to a new foreground tab open in Peek
+// instead (rangaPrivate.setPeekTabs()).
+void RangaSetPeekTabs(base::flat_set<int> tab_ids);
+bool RangaIsPeekTab(int tab_id);
+
+// Opens a link of `source` in a Peek over `browser`'s page: `params` to load,
+// or `*contents`, a page already made (window.open()), which the Peek takes.
+// Returns the Peek's page, or null, leaving `*contents` alone, when the window
+// can't.
+using RangaPeekOpener = base::RepeatingCallback<content::WebContents*(
+    BrowserWindowInterface* browser,
+    content::WebContents* source,
+    const content::OpenURLParams* params,
+    std::unique_ptr<content::WebContents>* contents)>;
+void RangaSetPeekOpener(RangaPeekOpener opener);
+content::WebContents* RangaOpenPeek(
+    BrowserWindowInterface* browser,
+    content::WebContents* source,
+    const content::OpenURLParams* params,
+    std::unique_ptr<content::WebContents>* contents);
+
+#endif  // CHROME_BROWSER_RANGA_RANGA_LINKS_H_
