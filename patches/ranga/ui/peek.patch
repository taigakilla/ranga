+// Peek: a page in a floating card over the page area, kept out of the tab
+// strip until it's promoted. The window's peek.html overlay, under it, draws
+// the backdrop and Peek's toolbar.
+class RangaPeekView : public views::WebView,
+                      public TabStripModelObserver,
+                      public views::ViewObserver {
+  METADATA_HEADER(RangaPeekView, views::WebView)
