+void RangaPreparePeek(BrowserView* browser_view) {
+  static bool installed = false;
+  if (!installed) {
+    installed = true;
+    RangaSetPeekOpener(base::BindRepeating(&OpenPeekIn));
+  }
+  RangaOverlayFor(browser_view, kPeekPage)->Preload();
+}
+
+content::WebContents* RangaPeekContents(BrowserWindowInterface* browser) {
+  RangaPeekView* peek = RangaPeekView::From(browser);
+  return peek && peek->IsOpen() ? peek->contents() : nullptr;
+}
+
+bool RangaFocusPeek(BrowserView* browser_view) {
+  RangaPeekView* peek = PeekIn(browser_view);
+  if (!peek || !peek->IsOpen() || !peek->GetVisible()) {
+    return false;
+  }
+  peek->RequestFocus();
+  return true;
+}
