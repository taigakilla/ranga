+ExtensionFunction::ResponseAction RangaPrivateClosePeekFunction::Run() {
+  auto params = ranga_private::ClosePeek::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  if (RangaPeekView* peek = RangaPeekView::From(browser)) {
+    peek->Close();
+  }
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction RangaPrivatePromotePeekFunction::Run() {
+  auto params = ranga_private::PromotePeek::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  RangaPeekView* peek = RangaPeekView::From(browser);
+  std::optional<int> tab_id = peek ? peek->Promote() : std::nullopt;
+  if (!tab_id) {
+    return RespondNow(Error(kNoPeekError));
+  }
+  return RespondNow(WithArguments(*tab_id));
+}
