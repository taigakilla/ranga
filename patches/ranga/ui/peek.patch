+namespace {
+
+constexpr char kPeekPage[] = "peek.html";
+constexpr int kToolbarSpace = 56;
+constexpr int kBottomSpace = 16;
+constexpr float kCornerRadius = 10;
+constexpr base::TimeDelta kRevealTimeout = base::Milliseconds(700);
+
+gfx::Rect PeekBounds(const gfx::Rect& area) {
+  const int side = std::clamp(area.width() * 6 / 100, 16, 96);
+  return gfx::Rect(area.x() + side, area.y() + kToolbarSpace,
+                   std::max(0, area.width() - side * 2),
+                   std::max(0, area.height() - kToolbarSpace - kBottomSpace));
+}
+
+bool RangaHidesNativeChrome(const BrowserWindowInterface* browser) {
+  return !base::CommandLine::ForCurrentProcess()->HasSwitch(
+             "ranga-native-chrome") &&
+         browser->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL;
+}
+
+RangaPeekView* PeekIn(BrowserView* browser_view) {
+  for (views::View* child : browser_view->children()) {
+    if (auto* peek = views::AsViewClass<RangaPeekView>(child)) {
+      return peek;
+    }
+  }
+  return nullptr;
+}
+
+content::WebContents* OpenPeekIn(
+    BrowserWindowInterface* browser,
+    content::WebContents* source,
+    const content::OpenURLParams* params,
+    std::unique_ptr<content::WebContents>* contents) {
+  if (!RangaHidesNativeChrome(browser)) {
+    return nullptr;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view || !browser_view->GetWidget()) {
+    return nullptr;
+  }
+  RangaPeekView* peek = PeekIn(browser_view);
+  if (!peek) {
+    peek = browser_view->AddChildView(
+        std::make_unique<RangaPeekView>(browser_view));
+  }
+  return peek->Open(source, params, contents);
+}
+
+void AttachPeekHelpers(content::WebContents* contents) {
+  FindBarState::ConfigureWebContents(contents);
+  web_modal::WebContentsModalDialogManager::CreateForWebContents(contents);
+  permissions::PermissionRequestManager::CreateForWebContents(contents);
+  permissions::PermissionRecoverySuccessRateTracker::CreateForWebContents(
+      contents);
+  if (!content_settings::PageSpecificContentSettings::GetDelegateForWebContents(
+          contents)) {
+    content_settings::PageSpecificContentSettings::CreateForWebContents(
+        contents,
+        std::make_unique<PageSpecificContentSettingsDelegate>(contents));
+  }
+  favicon::CreateContentFaviconDriverForWebContents(contents);
+  extensions::TabHelper::CreateForWebContents(contents);
+  ChromePasswordManagerClient::CreateForWebContents(contents);
+  ChromeTranslateClient::CreateForWebContents(contents);
+  PrefsTabHelper::CreateForWebContents(contents);
+  HttpsOnlyModeTabHelper::CreateForWebContents(contents);
+  blocked_content::PopupBlockerTabHelper::CreateForWebContents(contents);
+}
+
+}  // namespace
+
+RangaPeekView::RangaPeekView(BrowserView* browser_view)
+    : browser_view_(browser_view) {
+  SetVisible(false);
+  browser_view_->browser()->GetTabStripModel()->AddObserver(this);
+  if (views::View* area = browser_view_->multi_contents_view()) {
+    area_observation_.Observe(area);
+  }
+}
+
+RangaPeekView::~RangaPeekView() {
+  reveal_timer_.Stop();
+  if (contents_) {
+    Release();
+  }
+}
+
+// static
+RangaPeekView* RangaPeekView::From(BrowserWindowInterface* browser) {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  return browser_view ? PeekIn(browser_view) : nullptr;
+}
+
+content::WebContents* RangaPeekView::Open(
+    content::WebContents* source,
+    const content::OpenURLParams* params,
+    std::unique_ptr<content::WebContents>* made) {
+  std::unique_ptr<content::WebContents> contents;
+  if (made && *made) {
+    contents = std::move(*made);
+  } else if (params && (params->url.SchemeIsHTTPOrHTTPS() ||
+                        params->url.IsAboutBlank())) {
+    contents = content::WebContents::Create(content::WebContents::CreateParams(
+        browser_view_->GetProfile(),
+        RangaContainerSiteInstanceFor(source, params->url)));
+  } else {
+    return nullptr;
+  }
+  const bool replacing = IsOpen();
+  if (replacing) {
+    Release();
+  }
+  TabHelpers::AttachTabHelpers(contents.get());
+  AttachPeekHelpers(contents.get());
+  contents->SetDelegate(this);
+  if (auto* dialogs =
+          web_modal::WebContentsModalDialogManager::FromWebContents(
+              contents.get())) {
+    dialogs->SetDelegate(
+        BrowserWindowModalDialogDelegate::From(browser_view_->browser()));
+  }
+  contents_ = std::move(contents);
+  if (params) {
+    contents_->GetController().LoadURLWithParams(
+        content::NavigationController::LoadURLParams(*params));
+  }
+  SetWebContents(contents_.get());
+  holder()->SetNativeViewCornerRadii(gfx::RoundedCornersF(kCornerRadius));
+  SetVisible(false);
+  const gfx::Rect area = RangaContentsArea(browser_view_);
+  RangaOverlayFor(browser_view_, kPeekPage)
+      ->Show(base::NumberToString(browser_view_->browser()->GetSessionID().id()),
+             area);
+  browser_view_->ReorderChildView(this, browser_view_->children().size());
+  SetBoundsRect(PeekBounds(area));
+  reveal_timer_.Start(FROM_HERE, kRevealTimeout,
+                      base::BindOnce(&RangaPeekView::Reveal,
+                                     weak_factory_.GetWeakPtr()));
+  Changed();
+  return contents_.get();
+}
+
+void RangaPeekView::Close() {
+  if (!IsOpen()) {
+    return;
+  }
+  std::unique_ptr<content::WebContents> contents = Release();
+  FocusPage();
+  Changed();
+}
+
+std::optional<int> RangaPeekView::Promote() {
+  if (!IsOpen()) {
+    return std::nullopt;
+  }
+  std::unique_ptr<content::WebContents> contents = Release();
+  const int tab_id = sessions::SessionTabHelper::IdForTab(contents.get()).id();
+  Changed(/*promoted=*/true);
+  browser_view_->browser()->GetTabStripModel()->AppendWebContents(
+      std::move(contents), /*foreground=*/true);
+  return tab_id;
+}
+
+void RangaPeekView::Reveal() {
+  reveal_timer_.Stop();
+  if (!IsOpen() || GetVisible()) {
+    return;
+  }
+  SetVisible(true);
+  RequestFocus();
+}
+
+std::optional<base::DictValue> RangaPeekView::State() {
+  if (!IsOpen()) {
+    return std::nullopt;
+  }
+  const gfx::Rect card =
+      PeekBounds(RangaContentsArea(browser_view_)) -
+      RangaContentsArea(browser_view_).OffsetFromOrigin();
+  const GURL& url = contents_->GetLastCommittedURL().is_empty()
+                        ? contents_->GetVisibleURL()
+                        : contents_->GetLastCommittedURL();
+  base::DictValue state;
+  state.Set("url", url.spec());
+  state.Set("title", base::UTF16ToUTF8(contents_->GetTitle()));
+  if (content::NavigationEntry* entry =
+          contents_->GetController().GetLastCommittedEntry();
+      entry && entry->GetFavicon().valid && entry->GetFavicon().url.is_valid()) {
+    state.Set("favIconUrl", entry->GetFavicon().url.spec());
+  }
+  state.Set("loading", contents_->IsLoading());
+  state.Set("card", base::DictValue()
+                        .Set("x", card.x())
+                        .Set("y", card.y())
+                        .Set("width", card.width())
+                        .Set("height", card.height()));
+  return state;
+}
+
+content::WebContents* RangaPeekView::OpenURLFromTab(
+    content::WebContents* source,
+    const content::OpenURLParams& params,
+    base::OnceCallback<void(content::NavigationHandle&)>
+        navigation_handle_callback) {
+  if (params.disposition == WindowOpenDisposition::CURRENT_TAB) {
+    source->GetController().LoadURLWithParams(
+        content::NavigationController::LoadURLParams(params));
+    return source;
+  }
+  return browser_view_->browser()->OpenURL(
+      params, std::move(navigation_handle_callback));
+}
+
+content::WebContents* RangaPeekView::AddNewContents(
+    content::WebContents* source,
+    std::unique_ptr<content::WebContents> new_contents,
+    const GURL& target_url,
+    WindowOpenDisposition disposition,
+    const blink::mojom::WindowFeatures& window_features,
+    bool user_gesture,
+    bool* was_blocked) {
+  return chrome::AddWebContents(browser_view_->browser(), source,
+                                std::move(new_contents), target_url,
+                                disposition, window_features,
+                                NavigateParams::WindowAction::kShowWindow,
+                                user_gesture);
+}
+
+content::KeyboardEventProcessingResult RangaPeekView::PreHandleKeyboardEvent(
+    content::WebContents* source,
+    const input::NativeWebKeyboardEvent& event) {
+  if (event.GetType() == blink::WebInputEvent::Type::kRawKeyDown) {
+    const int modifiers =
+        event.GetModifiers() &
+        (blink::WebInputEvent::kControlKey | blink::WebInputEvent::kAltKey |
+         blink::WebInputEvent::kShiftKey | blink::WebInputEvent::kMetaKey);
+    const int key = event.windows_key_code;
+    const bool ctrl = modifiers == blink::WebInputEvent::kControlKey;
+    const bool alt = modifiers == blink::WebInputEvent::kAltKey;
+    if ((key == ui::VKEY_ESCAPE && !modifiers) || (key == ui::VKEY_W && ctrl)) {
+      CloseSoon();
+      return content::KeyboardEventProcessingResult::HANDLED;
+    }
+    if (key == ui::VKEY_RETURN && ctrl) {
+      PromoteSoon();
+      return content::KeyboardEventProcessingResult::HANDLED;
+    }
+    if ((key == ui::VKEY_R && ctrl) || (key == ui::VKEY_F5 && !modifiers)) {
+      source->GetController().Reload(content::ReloadType::NORMAL, true);
+      return content::KeyboardEventProcessingResult::HANDLED;
+    }
+    if ((key == ui::VKEY_LEFT && alt) || (key == ui::VKEY_RIGHT && alt)) {
+      content::NavigationController& controller = source->GetController();
+      if (key == ui::VKEY_LEFT && controller.CanGoBack()) {
+        controller.GoBack();
+      } else if (key == ui::VKEY_RIGHT && controller.CanGoForward()) {
+        controller.GoForward();
+      }
+      return content::KeyboardEventProcessingResult::HANDLED;
+    }
+  }
+  return browser_view_->PreHandleKeyboardEvent(event);
+}
+
+bool RangaPeekView::HandleKeyboardEvent(
+    content::WebContents* source,
+    const input::NativeWebKeyboardEvent& event) {
+  return browser_view_->HandleKeyboardEvent(event);
+}
+
+void RangaPeekView::CloseContents(content::WebContents* source) {
+  CloseSoon();
+}
+
+void RangaPeekView::NavigationStateChanged(
+    content::WebContents* source,
+    content::InvalidateTypes changed_flags) {
+  ChangedSoon();
+}
+
+void RangaPeekView::LoadingStateChanged(content::WebContents* source,
+                                        bool should_show_loading_ui) {
+  ChangedSoon();
+}
