+
+std::unique_ptr<content::WebContents> RangaPeekView::Release() {
+  reveal_timer_.Stop();
+  SetVisible(false);
+  SetWebContents(nullptr);
+  contents_->SetDelegate(nullptr);
+  if (auto* dialogs = web_modal::WebContentsModalDialogManager::FromWebContents(
+          contents_.get())) {
+    dialogs->SetDelegate(nullptr);
+  }
+  return std::move(contents_);
+}
+
+void RangaPeekView::UpdateBounds() {
+  if (!IsOpen()) {
+    return;
+  }
+  const gfx::Rect area = RangaContentsArea(browser_view_);
+  SetBoundsRect(PeekBounds(area));
+  if (RangaSpotlightView* overlay = RangaFindOverlay(browser_view_, kPeekPage);
+      overlay && overlay->GetVisible()) {
+    overlay->SetBoundsRect(area);
+  }
+  ChangedSoon();
+}
+
+void RangaPeekView::FocusPage() {
+  if (views::WebView* page = browser_view_->GetActiveContentsWebView()) {
+    page->RequestFocus();
+    if (views::FocusManager* focus_manager = GetFocusManager()) {
+      focus_manager->SetStoredFocusView(page);
+    }
+  }
+}
+
+void RangaPeekView::Changed(bool promoted) {
+  change_pending_ = false;
+  BrowserWindowInterface* browser = browser_view_->browser();
+  Profile* profile = browser->GetProfile()->GetOriginalProfile();
+  base::ListValue args;
+  args.Append(browser->GetSessionID().id());
+  if (std::optional<base::DictValue> state = State()) {
+    args.Append(std::move(*state));
+  } else {
+    args.Append(base::Value());
+    args.Append(promoted);
+  }
+  extensions::EventRouter::Get(profile)->DispatchEventToExtension(
+      kRangaSidebarExtensionId,
+      std::make_unique<extensions::Event>(
+          extensions::events::COMMANDS_ON_COMMAND,
+          "rangaPrivate.onPeekChanged", std::move(args), profile));
+}
+
+void RangaPeekView::ChangedSoon() {
+  if (change_pending_ || !IsOpen()) {
+    return;
+  }
+  change_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<RangaPeekView> peek) {
+                       if (peek && peek->change_pending_ && peek->IsOpen()) {
+                         peek->Changed();
+                       }
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
+
+void RangaPeekView::CloseSoon() {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&RangaPeekView::Close, weak_factory_.GetWeakPtr()));
+}
+
+void RangaPeekView::PromoteSoon() {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(base::IgnoreResult(&RangaPeekView::Promote),
+                                weak_factory_.GetWeakPtr()));
+}
