+// Copyright 2026 The Ranga Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ranga/ranga_links.h"
+
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "content/public/browser/page_navigator.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+
+base::flat_set<int>& PeekTabs() {
+  static base::NoDestructor<base::flat_set<int>> tabs;
+  return *tabs;
+}
+
+RangaPeekOpener& PeekOpener() {
+  static base::NoDestructor<RangaPeekOpener> opener;
+  return *opener;
+}
+
+}  // namespace
+
+void RangaSetPeekTabs(base::flat_set<int> tab_ids) {
+  PeekTabs() = std::move(tab_ids);
+}
+
+bool RangaIsPeekTab(int tab_id) {
+  return PeekTabs().contains(tab_id);
+}
+
+void RangaSetPeekOpener(RangaPeekOpener opener) {
+  PeekOpener() = std::move(opener);
+}
+
+content::WebContents* RangaOpenPeek(
+    BrowserWindowInterface* browser,
+    content::WebContents* source,
+    const content::OpenURLParams* params,
+    std::unique_ptr<content::WebContents>* contents) {
+  return PeekOpener() ? PeekOpener().Run(browser, source, params, contents)
+                      : nullptr;
+}
