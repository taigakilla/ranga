+ExtensionFunction::ResponseAction RangaPrivateOpenPeekFunction::Run() {
+  auto params = ranga_private::OpenPeek::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  const GURL url(params->url);
+  if (!url.is_valid()) {
+    return RespondNow(Error(kBadUrlError, params->url));
+  }
+  content::OpenURLParams open(url, content::Referrer(),
+                              WindowOpenDisposition::NEW_FOREGROUND_TAB,
+                              ui::PAGE_TRANSITION_LINK,
+                              /*is_renderer_initiated=*/false);
+  if (!RangaOpenPeek(browser, ActiveContents(browser), &open, nullptr)) {
+    return RespondNow(Error(kNoPeekError));
+  }
+  return RespondNow(NoArguments());
+}
