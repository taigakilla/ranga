+#if !BUILDFLAG(IS_ANDROID)
+class RangaAppDownloadToasts : public download::DownloadItem::Observer {
+ public:
+  static void Start(BrowserWindowInterface* browser,
+                    download::DownloadItem* item) {
+    if (item->GetState() != download::DownloadItem::IN_PROGRESS) {
+      ShowEnd(browser, item);
+      return;
+    }
+    ToastParams params(ToastId::kRangaDownloadStarted);
+    params.body_string_override =
+        item->GetFileNameToReportUser().LossyDisplayName();
+    Show(browser, std::move(params));
+    new RangaAppDownloadToasts(browser, item);
+  }
+
+  ~RangaAppDownloadToasts() override { item_->RemoveObserver(this); }
+
+  void OnDownloadUpdated(download::DownloadItem* item) override {
+    if (item->GetState() == download::DownloadItem::IN_PROGRESS) {
+      return;
+    }
+    ShowEnd(browser_.get(), item);
+    delete this;
+  }
+
+  void OnDownloadDestroyed(download::DownloadItem* item) override {
+    delete this;
+  }
+
+ private:
+  RangaAppDownloadToasts(BrowserWindowInterface* browser,
+                         download::DownloadItem* item)
+      : browser_(browser->GetWeakPtr()), item_(item) {
+    item_->AddObserver(this);
+  }
+
+  static void ShowEnd(BrowserWindowInterface* browser,
+                      download::DownloadItem* item) {
+    const std::u16string name =
+        item->GetFileNameToReportUser().LossyDisplayName();
+    if (item->GetState() == download::DownloadItem::COMPLETE) {
+      ToastParams params(ToastId::kRangaDownloadDone);
+      params.body_string_override = l10n_util::GetStringFUTF16(
+          IDS_DOWNLOAD_COMPLETE_ACCESSIBLE_ALERT, name);
+      params.action_button_callback_data = base::Value(item->GetGuid());
+      Show(browser, std::move(params));
+    } else if (item->GetState() == download::DownloadItem::INTERRUPTED) {
+      ToastParams params(ToastId::kRangaDownloadFailed);
+      params.body_string_override = l10n_util::GetStringFUTF16(
+          IDS_DOWNLOAD_FAILED_ACCESSIBLE_ALERT, name);
+      Show(browser, std::move(params));
+    }
+  }
+
+  static void Show(BrowserWindowInterface* browser, ToastParams params) {
+    if (ToastController* toasts =
+            browser ? ToastController::From(browser) : nullptr) {
+      toasts->MaybeShowToast(std::move(params));
+    }
+  }
+
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  raw_ptr<download::DownloadItem> item_;
+};
+#endif
 }  // namespace
 
