+ExtensionFunction::ResponseAction RangaPrivateSetSidebarModeFunction::Run() {
+  auto params = ranga_private::SetSidebarMode::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  const std::optional<RangaSidebarMode> mode =
+      ParseRangaSidebarMode(params->mode);
+  if (!mode) {
+    return RespondNow(Error("Unknown sidebar mode: " + params->mode));
+  }
+  RangaSetSidebarMode(browser, *mode);
+  return RespondNow(NoArguments());
+}
