+
+namespace {
+
+base::flat_map<SessionID::id_type, RangaSidebarMode>& Modes() {
+  static base::NoDestructor<base::flat_map<SessionID::id_type, RangaSidebarMode>>
+      modes;
+  return *modes;
+}
+
+std::string ModeName(RangaSidebarMode mode) {
+  switch (mode) {
+    case RangaSidebarMode::kDocked:
+      return "docked";
+    case RangaSidebarMode::kCollapsed:
+      return "collapsed";
+    case RangaSidebarMode::kFloating:
+      return "floating";
+  }
+}
+
+// A collapsed sidebar keeps only a thin strip inside the window, and window
+// managers with gaps leave the screen edge outside of it: a pointer pushed to
+// the edge crosses the strip between two events. Reaching the window's edge
+// on the sidebar's side, or leaving the window through it, floats the sidebar.
+class EdgeWatcher : public ui::EventHandler, public aura::WindowObserver {
+ public:
+  EdgeWatcher(BrowserWindowInterface* browser, aura::Window* root)
+      : browser_(browser), id_(browser->GetSessionID().id()), root_(root) {
+    root_->AddPreTargetHandler(this);
+    root_->AddObserver(this);
+  }
+  EdgeWatcher(const EdgeWatcher&) = delete;
+  EdgeWatcher& operator=(const EdgeWatcher&) = delete;
+  ~EdgeWatcher() override {
+    root_->RemovePreTargetHandler(this);
+    root_->RemoveObserver(this);
+  }
+
+  void OnMouseEvent(ui::MouseEvent* event) override {
+    const bool exited = event->type() == ui::EventType::kMouseExited;
+    if ((!exited && event->type() != ui::EventType::kMouseMoved) ||
+        RangaGetSidebarMode(browser_) != RangaSidebarMode::kCollapsed) {
+      return;
+    }
+    BrowserView* view = BrowserView::GetBrowserViewForBrowser(browser_);
+    if (!view || !view->side_panel()) {
+      return;
+    }
+    const gfx::PointF point = event->root_location_f();
+    const gfx::Size size = root_->bounds().size();
+    const float side = view->side_panel()->IsRightAligned()
+                           ? size.width() - point.x()
+                           : point.x();
+    const float reach = exited ? kReach : kRangaSidebarEdgeWidth;
+    if (side <= reach && side < point.y() && side < size.height() - point.y()) {
+      RangaSetSidebarMode(browser_, RangaSidebarMode::kFloating);
+    }
+  }
+
+  void OnWindowDestroying(aura::Window* window) override;
+
+ private:
+  static constexpr float kReach = 48;
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const SessionID::id_type id_;
+  const raw_ptr<aura::Window> root_;
+};
+
+base::flat_map<SessionID::id_type, std::unique_ptr<EdgeWatcher>>& Watchers() {
+  static base::NoDestructor<
+      base::flat_map<SessionID::id_type, std::unique_ptr<EdgeWatcher>>>
+      watchers;
+  return *watchers;
+}
+
+void EdgeWatcher::OnWindowDestroying(aura::Window* window) {
+  Watchers().erase(id_);
+}
+
+void WatchEdge(BrowserWindowInterface* browser, BrowserView* view) {
+  const SessionID::id_type id = browser->GetSessionID().id();
+  if (Watchers().contains(id) || !view->GetWidget()) {
+    return;
+  }
+  aura::Window* root = view->GetWidget()->GetNativeWindow()->GetRootWindow();
+  if (root) {
+    Watchers()[id] = std::make_unique<EdgeWatcher>(browser, root);
+  }
+}
+
+}  // namespace
+
+std::optional<RangaSidebarMode> ParseRangaSidebarMode(std::string_view mode) {
+  for (RangaSidebarMode candidate :
+       {RangaSidebarMode::kDocked, RangaSidebarMode::kCollapsed,
+        RangaSidebarMode::kFloating}) {
+    if (mode == ModeName(candidate)) {
+      return candidate;
+    }
+  }
+  return std::nullopt;
+}
+
+RangaSidebarMode RangaGetSidebarMode(const BrowserWindowInterface* browser) {
+  auto it = Modes().find(browser->GetSessionID().id());
+  return it == Modes().end() ? RangaSidebarMode::kDocked : it->second;
+}
+
+void RangaSetSidebarMode(BrowserWindowInterface* browser,
+                         RangaSidebarMode mode) {
+  if (RangaGetSidebarMode(browser) == mode) {
+    return;
+  }
+  Modes()[browser->GetSessionID().id()] = mode;
+  if (BrowserView* view = BrowserView::GetBrowserViewForBrowser(browser)) {
+    if (mode == RangaSidebarMode::kCollapsed) {
+      WatchEdge(browser, view);
+    }
+    view->InvalidateLayout();
+  }
+  Profile* profile = browser->GetProfile()->GetOriginalProfile();
+  base::ListValue args;
+  args.Append(ModeName(mode));
+  args.Append(browser->GetSessionID().id());
+  extensions::EventRouter::Get(profile)->DispatchEventToExtension(
+      kRangaSidebarExtensionId,
+      std::make_unique<extensions::Event>(
+          extensions::events::COMMANDS_ON_COMMAND,
+          "rangaPrivate.onSidebarModeChanged", std::move(args), profile));
+}
