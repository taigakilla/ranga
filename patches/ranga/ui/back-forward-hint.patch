+void RangaShowNavigationHint(BrowserWindowInterface* browser, bool back) {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "ranga-native-chrome") ||
+      browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+    return;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view) {
+    return;
+  }
+  constexpr int kSize = 112;
+  const gfx::Rect area = RangaContentsArea(browser_view);
+  const gfx::Rect box(back ? area.x() : area.right() - kSize,
+                      area.y() + (area.height() - kSize) / 2, kSize, kSize);
+  RangaOverlayFor(browser_view, "nav.html")
+      ->Show(back ? "back" : "forward", box, /*focus=*/false);
+}
