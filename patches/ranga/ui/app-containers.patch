+ExtensionFunction::ResponseAction RangaPrivateInstallAppFunction::Run() {
+  auto params = ranga_private::InstallApp::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  web_app::WebAppProvider* provider =
+      web_app::WebAppProvider::GetForWebApps(browser->GetProfile());
+  content::WebContents* contents =
+      browser->GetTabStripModel()->GetActiveWebContents();
+  if (!provider || !contents) {
+    return RespondNow(Error(kNoCommandError, "installApp"));
+  }
+  const bool installed =
+      provider->registrar_unsafe()
+          .FindBestAppWithUrlInScope(
+              contents->GetLastCommittedURL(),
+              web_app::WebAppFilter::IsAppSurfaceableToUser())
+          .has_value();
+  RangaPendingSpaceInstall() = RangaSpaceInstall{
+      browser->GetProfile()->GetPath(), params->container, params->name,
+      installed, base::TimeTicks::Now()};
+  chrome::ExecuteCommand(browser,
+                         installed ? IDC_OPEN_IN_PWA_WINDOW : IDC_INSTALL_PWA);
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction RangaPrivateSyncSpacesFunction::Run() {
+  auto params = ranga_private::SyncSpaces::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  const ranga_private::SpacesState& state = params->state;
+  RangaWindowContainers()[browser->GetSessionID().id()] = state.container;
+
+  std::map<int, std::string> space_of;
+  for (const ranga_private::TabSpace& tab : state.tabs) {
+    space_of[tab.tab_id] = tab.space;
+  }
+  TabStripModel* model = browser->GetTabStripModel();
+  for (int i = 0; i < model->count(); ++i) {
+    content::WebContents* contents = model->GetWebContentsAt(i);
+    auto it = space_of.find(ExtensionTabUtil::GetTabId(contents));
+    if (it != space_of.end()) {
+      RangaTabSpace::Set(contents, it->second);
+    }
+  }
+
+  std::map<std::string, std::string> names;
+  for (const ranga_private::SpaceName& space : state.spaces) {
+    names[space.container] = space.name;
+  }
+  Profile* profile = browser->GetProfile();
+  static base::NoDestructor<
+      std::map<base::FilePath, std::map<std::string, std::string>>>
+      known;
+  std::map<std::string, std::string>& last = (*known)[profile->GetPath()];
+  if (last != names) {
+    last = names;
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock()},
+        base::BindOnce(&RenameRangaSpaces, profile->GetPath(), names),
+        base::BindOnce(
+            [](base::WeakPtr<Profile> profile,
+               std::vector<std::string> renamed) {
+              web_app::WebAppProvider* provider =
+                  profile ? web_app::WebAppProvider::GetForWebApps(
+                                profile.get())
+                          : nullptr;
+              if (!provider) {
+                return;
+              }
+              web_app::SynchronizeOsOptions options;
+              options.force_create_shortcuts = true;
+              for (const std::string& app_id : renamed) {
+                provider->scheduler().SynchronizeOsIntegration(
+                    app_id, base::DoNothing(), options);
+              }
+            },
+            profile->GetWeakPtr()));
+  }
+  return RespondNow(NoArguments());
+}
