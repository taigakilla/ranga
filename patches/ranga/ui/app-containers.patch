+// Copyright 2026 The Ranga Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_RANGA_RANGA_SPACE_APPS_H_
+#define CHROME_BROWSER_RANGA_RANGA_SPACE_APPS_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/no_destructor.h"
+#include "base/time/time.h"
+#include "base/values.h"
+
+struct RangaAppSpaces {
+  bool main = true;
+  std::map<std::string, std::string> spaces;
+};
+
+struct RangaSpaceInstall {
+  base::FilePath profile_path;
+  std::string container;
+  std::string name;
+  bool installed = false;
+  base::TimeTicks at;
+};
+
+inline std::optional<RangaSpaceInstall>& RangaPendingSpaceInstall() {
+  static base::NoDestructor<std::optional<RangaSpaceInstall>> pending;
+  return *pending;
+}
+
+inline base::FilePath RangaSpaceAppsFile(const base::FilePath& profile_path) {
+  return profile_path.AppendASCII("Ranga Space Apps.json");
+}
+
+inline base::DictValue ReadRangaSpaceApps(const base::FilePath& profile_path) {
+  std::string json;
+  if (!base::ReadFileToString(RangaSpaceAppsFile(profile_path), &json)) {
+    return base::DictValue();
+  }
+  std::optional<base::DictValue> all =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  return all ? std::move(*all) : base::DictValue();
+}
+
+inline std::optional<RangaAppSpaces> RangaSpacesOfApp(
+    const base::FilePath& profile_path,
+    const std::string& app_id) {
+  base::DictValue all = ReadRangaSpaceApps(profile_path);
+  const base::DictValue* app = all.FindDict(app_id);
+  if (!app) {
+    return std::nullopt;
+  }
+  RangaAppSpaces result;
+  result.main = app->FindBool("main").value_or(true);
+  if (const base::DictValue* spaces = app->FindDict("spaces")) {
+    for (const auto [container, name] : *spaces) {
+      if (name.is_string()) {
+        result.spaces[container] = name.GetString();
+      }
+    }
+  }
+  return result;
+}
+
+inline void AddRangaSpaceApp(const base::FilePath& profile_path,
+                             const std::string& app_id,
+                             const RangaSpaceInstall& install) {
+  base::DictValue all = ReadRangaSpaceApps(profile_path);
+  base::DictValue* app = all.FindDict(app_id);
+  if (!app || !install.installed) {
+    base::DictValue fresh;
+    fresh.Set("main", install.installed);
+    app = all.Set(app_id, std::move(fresh))->GetIfDict();
+  }
+  if (install.container.empty()) {
+    app->Set("main", true);
+  } else {
+    app->EnsureDict("spaces")->Set(install.container, install.name);
+  }
+  if (std::optional<std::string> json = base::WriteJson(all)) {
+    base::ImportantFileWriter::WriteFileAtomically(
+        RangaSpaceAppsFile(profile_path), *json);
+  }
+}
+
+inline std::vector<std::string> RenameRangaSpaces(
+    const base::FilePath& profile_path,
+    const std::map<std::string, std::string>& names) {
+  base::DictValue all = ReadRangaSpaceApps(profile_path);
+  std::vector<std::string> renamed;
+  for (auto [app_id, app] : all) {
+    base::DictValue* spaces =
+        app.is_dict() ? app.GetDict().FindDict("spaces") : nullptr;
+    if (!spaces) {
+      continue;
+    }
+    bool changed = false;
+    for (auto [container, name] : *spaces) {
+      auto it = names.find(container);
+      if (it != names.end() && name.is_string() &&
+          name.GetString() != it->second) {
+        name = base::Value(it->second);
+        changed = true;
+      }
+    }
+    if (changed) {
+      renamed.push_back(app_id);
+    }
+  }
+  if (!renamed.empty()) {
+    if (std::optional<std::string> json = base::WriteJson(all)) {
+      base::ImportantFileWriter::WriteFileAtomically(
+          RangaSpaceAppsFile(profile_path), *json);
+    }
+  }
+  return renamed;
+}
+
+inline bool RemoveRangaSpaceApp(const base::FilePath& profile_path,
+                                const std::string& app_id,
+                                const std::string& container) {
+  base::DictValue all = ReadRangaSpaceApps(profile_path);
+  base::DictValue* app = all.FindDict(app_id);
+  if (!app) {
+    return false;
+  }
+  base::DictValue* spaces = app->EnsureDict("spaces");
+  const bool main = app->FindBool("main").value_or(true);
+  if (container.empty()) {
+    if (spaces->empty()) {
+      return false;
+    }
+    app->Set("main", false);
+  } else {
+    if (!spaces->contains(container) || (spaces->size() == 1 && !main)) {
+      return false;
+    }
+    spaces->Remove(container);
+  }
+  std::optional<std::string> json = base::WriteJson(all);
+  return json && base::ImportantFileWriter::WriteFileAtomically(
+                     RangaSpaceAppsFile(profile_path), *json);
+}
+
+#endif  // CHROME_BROWSER_RANGA_RANGA_SPACE_APPS_H_
