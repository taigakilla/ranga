+void DeleteRangaSpaceShortcuts(base::Environment* env,
+                               const base::FilePath& profile_path,
+                               const std::string& app_id) {
+  base::FileEnumerator files(
+      base::nix::GetXDGDataWriteLocation(env).Append("applications"),
+      /*recursive=*/false, base::FileEnumerator::FILES,
+      GetShortcutFileName(profile_path, app_id) + "-*.desktop");
+  for (base::FilePath file = files.Next(); !file.empty(); file = files.Next()) {
+    DeleteShortcutInApplicationsMenu(file.BaseName(),
+                                     base::FilePath(kDirectoryFilename));
+  }
+}
+
+bool CreateRangaSpaceShortcuts(base::Environment* env,
+                               const ShortcutInfo& shortcut_info,
+                               const base::FilePath& chrome_exe_path,
+                               const std::string& app_name,
+                               const std::string& icon_name,
+                               const RangaAppSpaces& spaces,
+                               const base::FilePath& directory_filename,
+                               const std::string& directory_contents) {
+  bool success = true;
+  for (const auto& [container, name] : spaces.spaces) {
+    base::CommandLine command = shell_integration::CommandLineArgsForLauncher(
+        shortcut_info.url, shortcut_info.app_id, shortcut_info.profile_path,
+        "");
+    command.SetProgram(chrome_exe_path);
+    command.AppendSwitchASCII(kRangaContainerSwitch, container);
+    std::string contents =
+        shell_integration_linux::GetDesktopFileContentsForCommand(
+            command, app_name, shortcut_info.url,
+            shortcut_info.title + u" — " + base::UTF8ToUTF16(name), icon_name,
+            "", "", false, "", {});
+    std::string filename =
+        GetShortcutFileName(shortcut_info.profile_path, shortcut_info.app_id) +
+        "-" + container;
+    base::i18n::ReplaceIllegalCharactersInPath(&filename, '_');
+    base::ReplaceChars(filename, " ", "_", &filename);
+    success = CreateShortcutInApplicationsMenu(
+                  env, base::FilePath(filename + ".desktop"), contents,
+                  directory_filename, directory_contents) &&
+              success;
+  }
+  return success;
+}
