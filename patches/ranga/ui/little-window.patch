+
+ExtensionFunction::ResponseAction RangaPrivateOpenInMainWindowFunction::Run() {
+  auto params = ranga_private::OpenInMainWindow::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  std::string error;
+  BrowserWindowInterface* little =
+      BrowserForWindow(this, params->window_id, &error);
+  if (!little) {
+    return RespondNow(Error(std::move(error)));
+  }
+  if (!RangaIsLittle(little)) {
+    return RespondNow(Error(kNotLittleError));
+  }
+  TabStripModel* from = little->GetTabStripModel();
+  if (from->active_index() == TabStripModel::kNoTab) {
+    return RespondNow(Error(kNoMainWindowError));
+  }
+  Profile* profile = little->GetProfile();
+  BrowserWindowInterface* main = RangaMainWindow(profile);
+  const bool new_main = !main;
+  if (new_main) {
+    if (GetBrowserWindowCreationStatusForProfile(*profile) !=
+        BrowserWindowInterface::CreationStatus::kOk) {
+      return RespondNow(Error(kNoMainWindowError));
+    }
+    BrowserWindowCreateParams create(*profile, /*from_user_gesture=*/true);
+    create.should_trigger_session_restore = false;
+    main = CreateBrowserWindow(std::move(create));
+  }
+  const int tab_id = ExtensionTabUtil::GetTabId(from->GetActiveWebContents());
+  std::unique_ptr<tabs::TabModel> tab =
+      from->DetachTabAtForInsertion(from->active_index());
+  TabStripModel* to = main->GetTabStripModel();
+  to->InsertDetachedTabAt(to->count(), std::move(tab), AddTabTypes::ADD_ACTIVE);
+  if (new_main) {
+    main->GetWindow()->Show();
+  }
+  main->GetWindow()->Activate();
+  return RespondNow(WithArguments(tab_id));
+}
