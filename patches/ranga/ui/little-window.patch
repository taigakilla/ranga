+gfx::Rect RangaLittleBounds(int step) {
+  constexpr int kWidth = 1000;
+  constexpr int kHeight = 720;
+  constexpr int kCascade = 28;
+  display::Screen* screen = display::Screen::Get();
+  const gfx::Rect area =
+      screen->GetDisplayNearestPoint(screen->GetCursorScreenPoint())
+          .work_area();
+  const int width = std::min(kWidth, area.width() - 48);
+  const int height = std::min(kHeight, area.height() - 48);
+  const int offset = step * kCascade;
+  return gfx::Rect(area.x() + (area.width() - width) / 2 + offset,
+                   area.y() + (area.height() - height) / 2 + offset, width,
+                   height);
+}
+
+// Links another app hands an already running Ranga open in small windows of
+// their own (one per link) instead of tabs of the main window.
+bool RangaOpenLinksInLittle(const base::CommandLine& command_line,
+                            const base::FilePath& cur_dir,
+                            Profile* profile) {
+  if (!profile || profile->IsOffTheRecord() || !RangaOpensLinksInLittle() ||
+      command_line.HasSwitch(switches::kOpenInNewWindow) ||
+      command_line.HasSwitch(switches::kIncognito) ||
+      command_line.HasSwitch(switches::kApp) ||
+      command_line.HasSwitch(switches::kAppId) ||
+      command_line.HasSwitch("ranga-native-chrome") ||
+      command_line.HasSwitch("ranga-no-little") ||
+      !RangaMainWindow(profile) ||
+      GetBrowserWindowCreationStatusForProfile(*profile) !=
+          BrowserWindowInterface::CreationStatus::kOk) {
+    return false;
+  }
+  const StartupTabs tabs = StartupTabProviderImpl().GetCommandLineTabs(
+      command_line, cur_dir, profile);
+  if (tabs.empty() ||
+      std::ranges::any_of(tabs, [](const StartupTab& tab) {
+        return tab.is_untrusted_launch || !tab.url.is_valid();
+      })) {
+    return false;
+  }
+#if BUILDFLAG(IS_LINUX)
+  std::string startup_id =
+      command_line.GetSwitchValueASCII(base::nix::kXdgActivationTokenSwitch);
+  if (startup_id.empty()) {
+    startup_id = command_line.GetSwitchValueASCII("desktop-startup-id");
+  }
+#endif
+  for (size_t i = 0; i < tabs.size(); ++i) {
+    BrowserWindowCreateParams params(BrowserWindowInterface::TYPE_NORMAL,
+                                     *profile, /*from_user_gesture=*/true);
+    params.initial_bounds = RangaLittleBounds(static_cast<int>(i));
+    params.omit_from_session_restore = true;
+    params.should_trigger_session_restore = false;
+#if BUILDFLAG(IS_LINUX)
+    params.startup_id = startup_id;
+#endif
+    BrowserWindowInterface* little = nullptr;
+    {
+      base::AutoReset<bool> creating(&RangaCreatingLittle(), true);
+      little = CreateBrowserWindow(std::move(params));
+    }
+    if (!little) {
+      return i > 0;
+    }
+    RangaMarkLittle(little);
+    chrome::AddTabAt(little, tabs[i].url, -1, /*foreground=*/true);
+    little->GetWindow()->Show();
+  }
+  return true;
+}
