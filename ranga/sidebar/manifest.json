{
  "manifest_version": 3,
  "name": "Ranga — barra lateral",
  "version": "0.5.2",
  "key": "",
  "permissions": [
    "tabs",
    "sidePanel",
    "search",
    "nativeMessaging",
    "storage",
    "bookmarks",
    "favicon",
    "history",
    "sessions",
    "browsingData",
    "alarms",
    "offscreen",
    "clipboardWrite",
    "rangaPrivate",
    "settingsPrivate",
    "downloads",
    "downloads.open",
    "downloads.ui",
    "topSites",
    "identity",
    "management"
  ],
  "host_permissions": [
    "https://news.google.com/*",
    "https://api.open-meteo.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "action": {
    "default_title": "Ranga"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {},
    "copy-url": {
      "description": "Copiar a URL da aba atual"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
