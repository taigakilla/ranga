#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
out="$root/build/src/out/${1:-Release}"
[ -x "$out/ranga" ] || { echo "sem $out/ranga: compile antes" >&2; exit 1; }

chromium="$(. "$root/build/src/chrome/VERSION" && echo "$MAJOR.$MINOR.$BUILD.$PATCH")"
version="$(cat "$root/ranga/VERSION")-$chromium"
build="$(git -C "$root" rev-parse --short=10 HEAD)"
[ -z "$(git -C "$root" status --porcelain)" ] || build="$build-dirty.$(date +%m%d%H%M)"
name="ranga-$version-x86_64"
dir="$root/build/release/$name"

rm -rf "$dir"
mkdir -p "$dir/app/locales" "$dir/icons"

for file in ranga ranga_crashpad_handler chrome_100_percent.pak chrome_200_percent.pak resources.pak icudtl.dat \
            v8_context_snapshot.bin libEGL.so libGLESv2.so libvk_swiftshader.so libvulkan.so.1 vk_swiftshader_icd.json \
            libqt5_shim.so libqt6_shim.so xdg-mime xdg-settings; do
  [ -e "$out/$file" ] && cp -a "$out/$file" "$dir/app/"
done
cp "$out/locales/"*.pak "$dir/app/locales/"
(cd "$dir/app" && ln -sf ranga chrome)

mkdir -p "$dir/app/resources/ranga-sidebar"
(cd "$root/ranga/sidebar" && find . -type f ! -name '*.test.js' ! -path './kurobe/*.test.*' -print0 | cpio -0pdm --quiet "$dir/app/resources/ranga-sidebar")
[ -f "$HOME/.config/ranga/google-client.json" ] && install -m 644 "$HOME/.config/ranga/google-client.json" "$dir/app/resources/ranga-sidebar/google-client.json"
stamp=$(cd "$dir/app/resources/ranga-sidebar" && find . -type f -print0 | sort -z | xargs -0 cat | cksum | cut -d' ' -f1)
python3 - "$dir/app/resources/ranga-sidebar/manifest.json" "$((stamp % 65535 + 1))" <<'PY'
import json, sys
path, stamp = sys.argv[1], sys.argv[2]
manifest = json.load(open(path))
manifest["version"] = f'{manifest["version"]}.{stamp}'
json.dump(manifest, open(path, "w"), ensure_ascii=False, indent=2)
PY
mkdir -p "$dir/app/theme"
cp "$root/ranga/theme/ranga_theme.py" "$root/ranga/theme/ranga_theme_host.py" "$root/ranga/theme/hook-theme-set" "$dir/app/theme/"

cp "$root/ranga/branding/"icon-*.png "$root/ranga/branding/icon.svg" "$dir/icons/"
cp "$root/ranga/package/ranga.desktop" "$root/ranga/package/install.sh" "$root/ranga/package/ranga-update" "$root/ranga/package/ranga-translatekit" "$dir/"
echo "$version" > "$dir/VERSION"
echo "$build" > "$dir/BUILD"
echo "$build" > "$dir/app/BUILD"

find "$dir/app" -maxdepth 1 -type f -exec file {} + | awk -F: '/ELF/ {print $1}' | xargs strip --strip-unneeded

tar -C "$root/build/release" -cf - "$name" | zstd -q -T0 -19 -o "$root/build/release/$name.tar.zst" -f
echo "$root/build/release/$name.tar.zst"
