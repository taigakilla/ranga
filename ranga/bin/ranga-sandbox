#!/usr/bin/env bash
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
sandbox="${CIEL_SANDBOX_BIN:-$HOME/dotfiles/shell/bin/ciel-sandbox}"
name="${RANGA_SANDBOX:-ranga}"
binary="${RANGA_BINARY:-$root/build/src/out/Default/ranga}"
extension="$root/ranga/sidebar"
extension_id="hncljkmljckjojdjincglklbdihcaeko"
debug_port="${RANGA_DEBUG_PORT:-9333}"

usage() {
  echo "uso: ranga-sandbox up | open [url...] | key <tecla> [modificador...] | eval <js> [pagina] | shot <saida.png> | theme <id> | down" >&2
  exit 2
}

in_sandbox() {
  "$sandbox" run "$name" -- "$@"
}

profile() {
  in_sandbox bash -c 'echo "$HOME/.local/share/ranga/dev-profile"'
}

case "${1:-}" in
  up)
    "$sandbox" list | grep -qw "$name" || "$sandbox" new "$name" >/dev/null 2>&1
    "$sandbox" list | grep -qw "$name" || "$sandbox" start "$name"
    in_sandbox env RANGA_PROFILE="$(profile)" "$root/ranga/bin/ranga-theme-install" "$extension_id"
    ;;
  open)
    shift
    p="$(profile)"
    [ -f "$HOME/.config/ranga/google-client.json" ] && cp "$HOME/.config/ranga/google-client.json" "$extension/google-client.json"
    first_run=(--no-first-run)
    [ -n "${RANGA_FIRST_RUN:-}" ] && first_run=()
    pkill -f "^$binary --user-data-dir=$p"
    sleep 1
    in_sandbox setsid -f env LANGUAGE="${RANGA_LANGUAGE:-pt_BR}" "$binary" --user-data-dir="$p" --ozone-platform=wayland \
      "${first_run[@]}" --ranga-sidebar-dir="$extension" ${RANGA_EXTRA_EXTENSIONS:+--load-extension="$RANGA_EXTRA_EXTENSIONS"} --password-store=basic --remote-debugging-port="$debug_port" --enable-logging=stderr "$@" >"${RANGA_LOG:-/dev/null}" 2>&1
    in_sandbox timeout 30 bash -c 'until hyprctl clients -j | jq -e "any(.[]; .class==\"ranga\")" >/dev/null; do sleep 1; done'
    sleep 4
    ;;
  key)
    shift
    key="$1"; shift
    args=()
    for m in "$@"; do args+=(-M "$m"); done
    args+=(-k "$key")
    for m in "$@"; do args+=(-m "$m"); done
    in_sandbox wtype "${args[@]}"
    ;;
  shot)
    "$sandbox" shot "$name" "${2:?saida.png}"
    ;;
  eval)
    node "$root/ranga/bin/ranga-eval.mjs" "$debug_port" "$extension_id" "${2:?expressao}" "${3:-sidebar.html}"
    ;;
  theme)
    in_sandbox ciel theme set "${2:?id do tema}"
    in_sandbox "$root/ranga/theme/hook-theme-set"
    ;;
  down)
    "$sandbox" stop "$name"
    ;;
  *)
    usage
    ;;
esac
