#!/usr/bin/env python3
"""Baixa do Google o tradutor do Chrome (TranslateKit) e o pacote inglês↔português da tradução do navegador."""
import hashlib
import io
import json
import os
from pathlib import Path
import re
import struct
import sys
import tempfile
import urllib.error
import urllib.request
import zipfile

PREFIX = Path(os.environ.get("RANGA_PREFIX", "/opt/ranga"))
DEST = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "ranga" / "TranslateKit"
UPDATE = "https://update.googleapis.com/service/update2/json"
COMPONENTS = {"lib": "lbimbicckdokpoicboneldipejkhjgdg", "en_pt": "mndbendcgoajojbgmkaeelmjjlhghhmc"}


def chromium():
    match = re.search(r"\d+\.\d+\.\d+\.\d+", (PREFIX / "current").resolve().name)
    return match.group(0) if match else "156.0.0.0"


def installed(name):
    try:
        return json.loads((DEST / name / "manifest.json").read_text())["version"]
    except (OSError, ValueError, KeyError):
        return "0.0.0.0"


def check(version):
    apps = [{"appid": appid, "version": installed(name), "enabled": True, "updatecheck": {}} for name, appid in COMPONENTS.items()]
    body = {"request": {"@os": "linux", "@updater": "chromium", "acceptformat": "crx3", "app": apps, "arch": "x64",
                        "dedup": "cr", "ismachine": False, "os": {"arch": "x86_64", "platform": "Linux"},
                        "prodversion": version, "protocol": "3.1", "updaterversion": version}}
    request = urllib.request.Request(UPDATE, json.dumps(body).encode(), {"Content-Type": "application/json", "User-Agent": "ranga-translatekit"})
    with urllib.request.urlopen(request, timeout=60) as response:
        text = response.read().decode()
    return {app["appid"]: app.get("updatecheck", {}) for app in json.loads(text[text.index("{"):])["response"]["app"]}


def fetch(update):
    package = update["manifest"]["packages"]["package"][0]
    base = next(url["codebase"] for url in update["urls"]["url"] if url["codebase"].startswith("https://"))
    with urllib.request.urlopen(base + package["name"], timeout=300) as response:
        data = response.read()
    if hashlib.sha256(data).hexdigest() != package["hash_sha256"]:
        raise RuntimeError(f"{package['name']} não confere com o sha256 do Google")
    if data[:4] != b"Cr24" or struct.unpack("<I", data[4:8])[0] != 3:
        raise RuntimeError(f"{package['name']} não é um crx3")
    header = struct.unpack("<I", data[8:12])[0]
    return zipfile.ZipFile(io.BytesIO(data[12 + header:]))


def install(name, archive):
    DEST.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=DEST, prefix=f".{name}-") as tmp:
        new = Path(tmp) / name
        archive.extractall(new)
        old = Path(tmp) / "old"
        if (DEST / name).exists():
            (DEST / name).rename(old)
        new.rename(DEST / name)


def main():
    updates = check(chromium())
    for name, appid in COMPONENTS.items():
        update = updates.get(appid, {})
        if update.get("status") == "ok":
            install(name, fetch(update))
            print(f"tradutor: {name} {update['manifest']['version']}")
        elif update.get("status") != "noupdate":
            raise RuntimeError(f"o Google não entregou {name}: {update.get('status')}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError, ValueError, KeyError, StopIteration, zipfile.BadZipFile, urllib.error.URLError) as error:
        print(f"ranga-translatekit: {error}", file=sys.stderr)
        sys.exit(1)
