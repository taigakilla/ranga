#!/usr/bin/env python3
"""Atualiza o Ranga pela Release mais nova do GitHub."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request

REPO = os.environ.get("RANGA_UPDATE_REPO", "taigakilla/ranga")
PREFIX = Path(os.environ.get("RANGA_PREFIX", "/opt/ranga"))
API = f"https://api.github.com/repos/{REPO}"


def request(url, accept="application/vnd.github+json"):
    headers = {"Accept": accept, "User-Agent": "ranga-update"}
    if os.environ.get("GITHUB_TOKEN"):
        headers["Authorization"] = f"Bearer {os.environ['GITHUB_TOKEN']}"
    return urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=60)


def get(url):
    with request(url) as response:
        return json.load(response)


def installed():
    try:
        return (PREFIX / "current" / "BUILD").read_text().strip()
    except OSError:
        return ""


def latest():
    try:
        release = get(f"{API}/releases/latest")
    except urllib.error.HTTPError as error:
        if error.code == 404:
            return None
        raise
    build = release["tag_name"].removeprefix("build-")
    assets = {asset["name"]: asset["browser_download_url"] for asset in release["assets"]}
    package = next((name for name in assets if name.endswith(".tar.zst")), None)
    if not package:
        raise RuntimeError(f"a release {release['tag_name']} não tem pacote")
    return build, package, assets


def behind(current, build):
    if not current:
        return True
    base = current.split("-dirty")[0]
    if base == build:
        return False
    try:
        return get(f"{API}/compare/{base}...{build}")["status"] == "ahead"
    except urllib.error.HTTPError as error:
        if error.code == 404:
            return False
        raise


def download(url, path):
    digest = hashlib.sha256()
    with request(url, "application/octet-stream") as response, open(path, "wb") as out:
        while chunk := response.read(1 << 20):
            digest.update(chunk)
            out.write(chunk)
    return digest.hexdigest()


def update(build, package, assets):
    with tempfile.TemporaryDirectory(prefix="ranga-update-") as tmp:
        archive = Path(tmp) / package
        print(f"baixando {package}", flush=True)
        digest = download(assets[package], archive)
        sums = assets.get(f"{package}.sha256")
        if not sums:
            raise RuntimeError(f"a release não tem {package}.sha256")
        with request(sums, "application/octet-stream") as response:
            expected = response.read().decode().split()[0]
        if expected != digest:
            raise RuntimeError("o pacote baixado não confere com o sha256 da release")
        subprocess.run(["tar", "-I", "zstd", "-xf", str(archive), "-C", tmp], check=True)
        script = next(Path(tmp).glob("ranga-*/install.sh"))
        subprocess.run([str(script)], check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="só diz se há versão nova")
    args = parser.parse_args()
    current = installed()
    release = latest()
    if not release:
        if not args.check:
            print("Nenhuma versão do Ranga publicada ainda.")
        return 0
    build, package, assets = release
    if not behind(current, build):
        if not args.check:
            print(f"Ranga já está atualizado ({current}).")
        return 0
    if args.check:
        print(f"ranga {current or 'não instalado'} -> {build}")
        return 0
    update(build, package, assets)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        print(f"ranga-update: {error}", file=sys.stderr)
        sys.exit(1)
