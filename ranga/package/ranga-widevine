#!/usr/bin/env python3
"""Baixa do Google o Widevine (o DRM dos streamings) quando o Chrome não está instalado pra emprestar o dele."""
import hashlib
import io
import json
import os
from pathlib import Path
import re
import struct
import sys
import tempfile
import urllib.error
import urllib.request
import zipfile

PREFIX = Path(os.environ.get("RANGA_PREFIX", "/opt/ranga"))
DEST = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "ranga" / "WidevineCdm"
UPDATE = "https://update.googleapis.com/service/update2/json"
APPID = "oimompecagnajdejgnnjijobebaeigek"


def chromium():
    match = re.search(r"\d+\.\d+\.\d+\.\d+", (PREFIX / "current").resolve().name)
    return match.group(0) if match else "157.0.0.0"


def installed():
    try:
        return json.loads((DEST / "manifest.json").read_text())["version"]
    except (OSError, ValueError, KeyError):
        return "0.0.0.0"


def check(version):
    app = {"appid": APPID, "version": installed(), "enabled": True, "updatecheck": {}}
    body = {"request": {"@os": "linux", "@updater": "chromium", "acceptformat": "crx3", "app": [app], "arch": "x64",
                        "dedup": "cr", "ismachine": False, "os": {"arch": "x86_64", "platform": "Linux"},
                        "prodversion": version, "protocol": "3.1", "updaterversion": version}}
    request = urllib.request.Request(UPDATE, json.dumps(body).encode(), {"Content-Type": "application/json", "User-Agent": "ranga-widevine"})
    with urllib.request.urlopen(request, timeout=60) as response:
        text = response.read().decode()
    return json.loads(text[text.index("{"):])["response"]["app"][0].get("updatecheck", {})


def fetch(update):
    package = update["manifest"]["packages"]["package"][0]
    base = next(url["codebase"] for url in update["urls"]["url"] if url["codebase"].startswith("https://"))
    with urllib.request.urlopen(base + package["name"], timeout=300) as response:
        data = response.read()
    if hashlib.sha256(data).hexdigest() != package["hash_sha256"]:
        raise RuntimeError(f"{package['name']} não confere com o sha256 do Google")
    if data[:4] != b"Cr24" or struct.unpack("<I", data[4:8])[0] != 3:
        raise RuntimeError(f"{package['name']} não é um crx3")
    header = struct.unpack("<I", data[8:12])[0]
    return zipfile.ZipFile(io.BytesIO(data[12 + header:]))


def install(archive):
    DEST.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=DEST.parent, prefix=".WidevineCdm-") as tmp:
        new = Path(tmp) / "new"
        archive.extractall(new)
        if not (new / "_platform_specific/linux_x64/libwidevinecdm.so").is_file():
            raise RuntimeError("o pacote do Google veio sem o libwidevinecdm.so")
        if DEST.exists():
            DEST.rename(Path(tmp) / "old")
        new.rename(DEST)


def main():
    update = check(chromium())
    if update.get("status") == "ok":
        install(fetch(update))
        print(f"widevine: {update['manifest']['version']}")
    elif update.get("status") != "noupdate":
        raise RuntimeError(f"o Google não entregou o Widevine: {update.get('status')}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError, ValueError, KeyError, StopIteration, zipfile.BadZipFile, urllib.error.URLError) as error:
        print(f"ranga-widevine: {error}", file=sys.stderr)
        sys.exit(1)
